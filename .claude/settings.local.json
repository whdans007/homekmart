{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(PATH=\"/c/xampp/php:$PATH\" php:*)",
      "Bash(PATH=\"/c/xampp/php:$PATH\" php -r:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(for table in stores users brands categories suppliers products inventory)",
      "Bash(do echo \"=== $table ===\")",
      "Bash(done)",
      "Bash(PATH=\"/c/xampp/php:$PATH\" php -r \"echo password_hash(''admin123'', PASSWORD_DEFAULT);\")",
      "Bash(export PATH=\"/c/xampp/php:$PATH\")",
      "Bash(php -r:*)",
      "Bash(php -l:*)",
      "Bash(php:*)",
      "Bash(PATH=\"/c/xampp/php:$PATH\")",
      "Bash(/c/xampp/php/php.exe:*)",
      "Bash(ls:*)"
    ],
    "deny": [],
    "ask": []
  }
}
