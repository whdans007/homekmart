{
  "name": "HomeKMartDelivery",
  "version": "1.0.0",
  "private": true,
  "description": "Philippines Delivery Shopping Mall App for HOME K MART",
  "author": "HOME K MART Development Team",
  "license": "UNLICENSED",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "react-native clean",
    "postinstall": "react-native setup-ios-permissions && pod-install ios",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "react-native run-ios --configuration Release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.4",
    
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/material-top-tabs": "^6.6.3",
    
    "@tanstack/react-query": "^4.32.6",
    "axios": "^1.5.0",
    
    "@react-native-google-signin/google-signin": "^10.0.1",
    
    "react-native-maps": "^1.7.1",
    "react-native-geolocation-service": "^5.3.1",
    
    "@react-native-async-storage/async-storage": "^1.19.3",
    "react-native-vector-icons": "^10.0.0",
    "react-native-image-picker": "^7.0.0",
    "react-native-permissions": "^3.8.4",
    
    "react-native-screens": "^3.22.1",
    "react-native-safe-area-context": "^4.7.2",
    "react-native-gesture-handler": "^2.12.1",
    "react-native-reanimated": "^3.5.4",
    
    "react-native-toast-message": "^2.1.6",
    "react-native-modal": "^13.0.1",
    "react-native-linear-gradient": "^2.8.3",
    
    "react-i18next": "^13.2.2",
    "i18next": "^23.5.1",
    
    "@types/react": "^18.2.21",
    "@types/react-native": "^0.72.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.2.1",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "typescript": "4.8.4",
    "react-test-renderer": "18.2.0"
  },
  "engines": {
    "node": ">=16"
  },
  "jest": {
    "preset": "react-native"
  },
  "keywords": [
    "react-native",
    "philippines",
    "delivery",
    "shopping",
    "ecommerce",
    "mobile-app",
    "cod-payment",
    "google-oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/homemart/delivery-app.git"
  },
  "homepage": "https://homemart.ph",
  "rnpm": {
    "assets": [
      "./src/assets/fonts/"
    ]
  }
}